{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    /* No DOM and no ambient types: core is pure TypeScript. */
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/core/**/*.ts"],
  "exclude": ["src/core/**/*.test.ts", "src/core/test-utils"]
}
