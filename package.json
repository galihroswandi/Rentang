{
  "name": "rentang",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.test.json && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:data-files": "node scripts/check-data-files.js",
    "peta": "node tools/peta-algoritma/bin/peta.js dev --config docs/peta/peta.config.json",
    "peta:build": "node tools/peta-algoritma/bin/peta.js build --config docs/peta/peta.config.json",
    "peta:check": "node tools/peta-algoritma/bin/peta.js check --config docs/peta/peta.config.json --strict",
    "peta:test": "node --test \"tools/peta-algoritma/test/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm check:data-files && pnpm peta:check && pnpm peta:test && pnpm lint && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Pelacak jadwal proyek berbasis Gantt dengan dokumen proyek, tanpa server.",
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "bits-ui": "^2.20.2",
    "dexie": "^4.4.7",
    "fast-xml-parser": "^5.11.2",
    "immer": "^11.2.9",
    "svelte": "^5.57.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
